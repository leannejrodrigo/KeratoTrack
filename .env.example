# Copy this file to .env and fill in values for your own machine.
# .env is ignored by Git. This example file must only ever contain variable
# NAMES and harmless placeholders, never real values or secrets.

# Folder OUTSIDE this repository that holds research datasets, patient-to-split
# assignments and per-record predictions. Nothing in it is ever committed.
# Example (Windows): C:\dev\KeratoTrack-data
KERATOTRACK_DATA_DIR=
