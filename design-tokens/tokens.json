      { "fg": "surface", "bg": "navy-700", "min": 7 },
      { "fg": "teal-700", "bg": "surface", "min": 4.5 },
      { "fg": "teal-700", "bg": "teal-50", "min": 4.5 },
      { "fg": "danger", "bg": "surface", "min": 4.5 },
      { "fg": "warning", "bg": "surface", "min": 4.5 },
      { "fg": "text-primary", "bg": "blue-50", "min": 7 },
      { "fg": "border-control", "bg": "surface", "min": 3 },
      { "fg": "blue-600", "bg": "surface", "min": 3 },
      { "fg": "teal-600", "bg": "surface", "min": 3 },
